# Скопируй в .env и заполни. .env в git НЕ коммитится (см. .gitignore).

# ── MongoDB (сервис на Railway + Volume на /data/db) ─────────────────
# На Railway ничего прописывать не нужно: сервис Mongo сам отдаёт MONGO_URL,
# приложение принимает и его, и MONGODB_URI (приоритет у MONGODB_URI).
# Локально сюда кладём публичную строку из Railway → Mongo → Variables.
MONGODB_URI=mongodb://user:password@host:port
MONGO_DB=vedic

# ── App JWT ──────────────────────────────────────────────────────────
# Сгенерируй длинную случайную строку: `openssl rand -hex 32`
JWT_SECRET=change-me-generate-a-long-random-string
JWT_LIFETIME_SECONDS=3600

# ── OAuth: Yandex ────────────────────────────────────────────────────
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# ── OAuth: VK (VK ID) ────────────────────────────────────────────────
VK_CLIENT_ID=
VK_CLIENT_SECRET=

# ── OAuth: Google (опционально) ──────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Telegram Login Widget (НЕ OAuth — проверка HMAC по токену бота) ───
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ── URLs ─────────────────────────────────────────────────────────────
# Публичный адрес бэкенда (для OAuth redirect_uri):
OAUTH_REDIRECT_BASE=http://localhost:8000
# Адрес фронта (куда возвращаем с токеном после логина):
FRONTEND_URL=http://localhost:3000
